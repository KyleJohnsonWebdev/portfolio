{
  "name": "frontend",
  "private": true,
  "scripts": {
    "prebuild": "sanity typegen generate",
    "build": "next build",
    "predev": "npm run sanity:typegen",
    "dev": "next dev",
    "lighthouse": "node scripts/lighthouse.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "sanity:typegen": "cd ../studio && sanity schema extract --force --enforce-required-fields --path ../sanity.schema.json && cd ../frontend && sanity typegen generate",
    "start": "next start",
    "test:e2e": "playwright test",
    "tokens": "node scripts/build-tokens.mjs",
    "type-check": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@sanity/client": "^8.16.0",
    "@sanity/image-url": "^2.1.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.1.0",
    "autoprefixer": "^10.6.2",
    "next": "^16.4.6",
    "next-sanity": "^13.4.0",
    "postcss": "^8.5.18",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sanity": "^6.22.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@lhci/cli": "^0.16.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "typescript": "^5.9.3"
  }
}
