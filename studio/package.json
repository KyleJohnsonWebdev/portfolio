{
  "name": "studio",
  "version": "1.0.0",
  "private": true,
  "keywords": [
    "sanity"
  ],
  "license": "UNLICENSED",
  "main": "package.json",
  "scripts": {
    "build": "sanity build",
    "deploy": "sanity deploy",
    "predev": "npm run sanity:typegen",
    "dev": "sanity dev",
    "lint": "eslint .",
    "sanity:typegen": "sanity schema extract --force --enforce-required-fields --path ../sanity.schema.json && sanity typegen generate",
    "start": "sanity start",
    "test": "node --test 'src/**/*.test.ts'",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@sanity/icons": "^3.8.0",
    "@sanity/vision": "^6.22.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rxjs": "^7.8.2",
    "sanity": "^6.22.0",
    "styled-components": "^6.6.0"
  },
  "devDependencies": {
    "@sanity/eslint-config-studio": "^6.0.0",
    "@types/react": "^19.3.0",
    "typescript": "^5.9.3"
  }
}
