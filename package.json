{
  "name": "portfolio",
  "description": "Kyle Johnson's design engineer portfolio: Next.js + Sanity",
  "keywords": [],
  "workspaces": [
    "studio",
    "frontend"
  ],
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "dev:next": "npm run dev --workspace=frontend",
    "dev:studio": "npm run dev --workspace=studio",
    "format": "prettier --cache --write .",
    "lint": "npm run lint --workspace=frontend",
    "type-check": "npm run type-check --workspaces",
    "test": "npm run test --workspace=studio"
  },
  "prettier": "@sanity/prettier-config",
  "devDependencies": {
    "@sanity/prettier-config": "^3.0.0",
    "npm-run-all2": "^5.0.2",
    "prettier": "^3.8.3",
    "turbo": "^2.10.2"
  },
  "packageManager": "npm@11.6.2"
}
